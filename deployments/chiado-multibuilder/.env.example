# Multibuilder experiment — environment variables
# Copy to .env and fill in your values.

# Builder #1 — primary. Its address determines L2_CONTEXT_ADDRESS,
# CROSS_CHAIN_MANAGER_ADDRESS, BRIDGE_L2_ADDRESS at deploy time. Signs
# block-1 protocol txs (deploy + initialize on L2).
BUILDER1_PRIVATE_KEY=0x_YOUR_BUILDER1_PRIVATE_KEY_HERE

# Builder #2 — secondary. Competes from block 2 onward.
BUILDER2_PRIVATE_KEY=0x_YOUR_BUILDER2_PRIVATE_KEY_HERE

# L1 read RPC (preferably a self-hosted Chiado node for low latency).
GNOSIS_RPC_URL=http://37.27.238.19:18545

# Block-builder RPC for `eth_sendBundle` postBatch submissions.
L1_BUILDER_RPC_URL=https://builder.chiado.gcd.ovh/

# Optional
#L1_GAS_OVERBID_PCT=20
#HEALTH_PORT=9100
